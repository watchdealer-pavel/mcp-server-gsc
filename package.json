{
  "name": "mcp-server-gsc",
  "version": "0.8.0",
  "description": "MCP server for Google Search Console: search analytics with multi-condition and regex filters, period comparison, quick-wins and cannibalization detection, URL inspection and sitemap management",
  "author": "Pavel from ChronoTimepieces (https://github.com/watchdealer-pavel)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-server-gsc": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "node --test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@googleapis/searchconsole": "^11.0.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "re2js": "^2.8.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "buffer-equal-constant-time": "file:./patches/buffer-equal-constant-time"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchdealer-pavel/mcp-server-gsc.git"
  },
  "homepage": "https://github.com/watchdealer-pavel/mcp-server-gsc#readme",
  "bugs": {
    "url": "https://github.com/watchdealer-pavel/mcp-server-gsc/issues"
  }
}
